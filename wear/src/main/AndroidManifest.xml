<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Scanning finds the lock by its own advertisement; it is never used to derive location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- No INTERNET permission: the app cannot send anything off the watch. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="s">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- No phone companion: every unlock is watch-to-lock only. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!--
          Exported because launchers and the tile renderer start it. Another app
          starting it only opens the UI: an automatic unlock needs the tile's
          per-install token (see LaunchToken).
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".unlock.UnlockService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".tile.UnlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_unlock"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Wear OS widget: hold the button for 3 s, release to unlock. -->
        <service
            android:name=".widget.UnlockWidgetService"
            android:exported="true"
            android:icon="@drawable/ic_unlock"
            android:label="@string/widget_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.glance.wear.action.BIND_WIDGET_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.glance.wear.widget.provider"
                android:resource="@xml/unlock_widget" />
        </service>

        <!--
          Credential intake for `adb shell content write`. DUMP is held by the
          ADB shell but cannot be granted to ordinary apps; the provider also
          checks the caller UID and requires arming on the watch.
        -->
        <provider
            android:name=".credential.ProvisioningProvider"
            android:authorities="uk.co.hectospark.yaleunlock.provision"
            android:exported="true"
            android:permission="android.permission.DUMP" />

    </application>

</manifest>
