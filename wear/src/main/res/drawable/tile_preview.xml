<?xml version="1.0" encoding="utf-8"?>
<!-- Tile picker preview: the tile's yellow Unlock button on black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF000000" />
            <size android:width="192dp" android:height="192dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="104dp" android:height="104dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFC94D" />
        </shape>
    </item>
    <item android:gravity="center" android:width="40dp" android:height="40dp">
        <inset android:drawable="@drawable/ic_unlock" />
    </item>
</layer-list>
